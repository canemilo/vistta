{
  "name": "vistta-api",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "build": "pnpm build:api && pnpm build:migrar && pnpm build:fuentes",
    "build:api": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/server.js --log-level=warning",
    "build:migrar": "esbuild scripts/migrar.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/migrar.js --log-level=warning",
    "build:fuentes": "esbuild scripts/comprobar-fuentes.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist/comprobar-fuentes.js --log-level=warning",
    "test:web": "pnpm --dir web run test:ci",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm test:web",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/migrar.ts",
    "db:seed:local": "tsx scripts/sembrar.ts",
    "user:create": "tsx scripts/crear-usuario.ts",
    "admin:create": "tsx scripts/crear-admin.ts",
    "setup:local": "pnpm db:up && pnpm db:migrate && pnpm db:seed:local",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "pnpm --dir web start",
    "dev:free": "lsof -ti:8787,4200 | xargs kill 2>/dev/null || true",
    "dev:all": "pnpm dev:free && concurrently -n api,web -c green,cyan --kill-others-on-fail \"pnpm dev:api\" \"pnpm dev:web\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@node-rs/argon2": "^2.2.0",
    "hono": "^4.6.14",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "~2.1.8"
  }
}
