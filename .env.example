# Copia a .env (ignorado por git) y pon valores propios.
# En producción van como secretos del host, no en un archivo del repo.

# --- Base de datos ---
# En local, la del docker-compose del repo:
DATABASE_URL=postgresql://vistta:vistta@localhost:5433/vistta
# En Supabase, Project Settings -> Database -> Connection string (pooler):
# DATABASE_URL=postgresql://postgres.TU_PROYECTO:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# --- Medios ---
# "supabase" en cualquier entorno real; "memory" solo para trastear en local.
# supabase | fs | memory. En local, 'fs' deja una demo que funciona sin credenciales.
STORAGE_FS_DIR=.medios-locales
STORAGE_DRIVER=fs
SUPABASE_URL=https://TU_PROYECTO.supabase.co
# SOLO backend: salta RLS. Nunca en el bundle de Angular ni en logs.
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_MEDIA_BUCKET=vistta-media

# Clave HMAC de las URLs firmadas. Mínimo 32 caracteres. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIA_SIGNING_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- App ---
BASE_URL=http://localhost:4200
PORT=8787
# Solo a true si delante hay un proxy propio que reescribe X-Forwarded-For.
# En false la cabecera se ignora: si no, cualquiera se salta el rate limit.
TRUST_PROXY=false

# Base de pruebas. Si no se define, el arnés usa la del docker-compose.
# TEST_DATABASE_URL=postgresql://vistta:vistta@localhost:5433/vistta

# --- Cobro manual (bloque F) ---
# A dónde paga el cliente. Se los enseña el backend a quien pide mejorar de plan,
# así que son públicos por definición: no son un secreto, son datos de contacto.
# Sin ninguno de los dos, pedir plan devuelve 503 en vez de dar un código inútil.
BIZUM_TELEFONO=600000000
PAYPAL_DESTINO=pagos@tudominio.com
