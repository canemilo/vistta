# Variables del despliegue. Se copia a `.env` JUNTO a compose.prod.yml, en el
# servidor, y NO se commitea.
#
#   cp deploy/env.produccion.ejemplo .env && $EDITOR .env
#   docker compose -f compose.prod.yml --env-file .env up -d

# --- Dominio y certificados --------------------------------------------------
DOMINIO=vistta.example
# Let's Encrypt avisa aquí si un certificado va a caducar sin renovarse.
ACME_EMAIL=tu-correo@example.com
# Origen público del viewer: es la base de los enlaces /v/<token>.
BASE_URL=https://vistta.example

# --- Base --------------------------------------------------------------------
POSTGRES_USER=vistta
POSTGRES_DB=vistta
# Genérala, no la escribas:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Firma de los medios -----------------------------------------------------
# 32 caracteres o más; por debajo la firma es adivinable. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarla invalida TODAS las URLs de medios ya emitidas.
MEDIA_SIGNING_KEY=

# --- Medios ------------------------------------------------------------------
# r2 en producción: no cobra el tráfico de salida, y aquí cada visita a una foto
# vuelve a leer el original para incrustarle su marca.
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=vistta-medios
# Solo si el bucket se creó con JURISDICCIÓN `eu` (la que garantiza que los
# bytes no salen de la UE): entonces el endpoint no es el estándar de la cuenta.
#   R2_ENDPOINT=https://<R2_ACCOUNT_ID>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=

# --- Cobro (opcional) --------------------------------------------------------
# Sin ninguno de los dos, pedir plan devuelve 503 en vez de dar un código que no
# lleva a ninguna parte.
BIZUM_TELEFONO=
PAYPAL_DESTINO=

# --- Identidad del titular y contacto legal -----------------------------------
# OBLIGATORIOS antes de abrir al público. Sin los cuatro, la página /legal dice
# que el despliegue no está configurado en vez de enseñar un aviso legal con
# huecos, y el procedimiento de retirada de contenido no lleva a ninguna parte.
TITULAR_NOMBRE=
TITULAR_IDENTIFICACION=
TITULAR_DIRECCION=
# Correo al que se avisa de un contenido y se ejercen los derechos del RGPD.
CONTACTO_LEGAL=

# --- Imágenes ----------------------------------------------------------------
IMAGEN_API=vistta-api:latest
IMAGEN_WEB=vistta-web:latest
