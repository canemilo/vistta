# syntax=docker/dockerfile:1
#
# Panel y viewer: se construyen aquí y salen dentro de un Caddy, para que
# desplegar sea traer una imagen y no compilar Angular en el servidor.

FROM node:22-bookworm-slim AS build
WORKDIR /app/web
RUN corepack enable
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY web/ ./
# Se conserva la forma del repositorio porque el build copia `legal/*.md` a los
# assets con `../scripts/copiar-legal.mjs`: los documentos tienen una sola
# versión buena y esta imagen no lleva la suya.
COPY legal /app/legal
COPY scripts/copiar-legal.mjs /app/scripts/copiar-legal.mjs
RUN pnpm build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /app/web/dist/web/browser /srv
